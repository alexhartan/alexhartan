---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Pillars from '../components/Pillars.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import Finale from '../components/Finale.astro';
---

<Base>
  <Preloader />
  <Nav />
  <main>
    <Hero />
    <Stats />
    <Pillars />
    <Work />
    <Process />
    <Finale />
  </main>
  <script>
    import '../scripts/main.js';
  </script>
  <noscript>
    <style>
      #preloader { display: none; }
      .h-letter { transform: none; opacity: 1; }
      [data-reveal] { opacity: 1; transform: none; }
      .beat { position: static !important; opacity: 1; transform: none; pointer-events: auto; }
      [data-seq-section] { height: auto !important; min-height: 100svh; }
    </style>
  </noscript>
</Base>
