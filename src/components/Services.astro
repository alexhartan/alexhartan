---
import SectionHead from './SectionHead.astro';

const services = [
  {
    n: '01',
    title: 'Brand Strategy',
    desc: 'A focused two-week sprint that gives your brand a clear direction and a place in the world. Positioning, messaging, naming — decided, not debated.',
    tags: ['Positioning', 'Messaging', 'Naming'],
  },
  {
    n: '02',
    title: 'Visual Identity',
    desc: "A distinctive identity built to represent who you've become — with a digital styleguide that keeps it consistent everywhere your brand shows up.",
    tags: ['Identity systems', 'Art direction', 'Styleguides'],
  },
  {
    n: '03',
    title: 'Web Design & Webflow',
    desc: 'Bespoke design in Figma, shipped as a clean, lightning-fast Webflow build. Six to ten pages, static and dynamic, live in about eight weeks.',
    tags: ['UX & UI', 'Webflow build', 'Interactions'],
  },
];
---

<section id="services" class="relative scroll-mt-24 py-24 md:py-36">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <SectionHead index="03" label="What I do" />

    <div class="border-b border-line">
      {
        services.map((s, i) => (
          <article class="sweep group border-t border-line" data-reveal style={`--d:${i * 0.08}s`}>
            <div class="grid items-start gap-4 py-10 transition-[padding] duration-400 group-hover:px-4 md:grid-cols-[5rem_1.2fr_1fr_3rem] md:items-center md:gap-8 md:py-14 md:group-hover:px-6">
              <span class="font-display text-sm font-semibold text-volt transition-colors duration-300 group-hover:text-void/70">
                {s.n}
              </span>
              <h3 class="font-display text-3xl font-bold tracking-tight uppercase transition-colors duration-300 group-hover:text-void sm:text-4xl md:text-5xl">
                {s.title}
              </h3>
              <div>
                <p class="max-w-md text-base leading-relaxed text-mute transition-colors duration-300 group-hover:text-void/80">
                  {s.desc}
                </p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {s.tags.map((t) => (
                    <li class="font-display rounded-full border border-line px-3 py-1 text-[11px] tracking-[0.14em] uppercase transition-colors duration-300 group-hover:border-void/30 group-hover:text-void">
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
              <span
                class="hidden text-3xl text-mute transition-[color,transform] duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-void md:block"
                aria-hidden="true"
              >
                ↗
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 max-w-2xl text-mute" data-reveal>
      Need the whole package? Strategy, identity and website come together as one tight
      <span class="text-ink">8-week engagement</span> over at
      <a
        href="https://www.galvanite.io"
        class="text-ink underline decoration-volt/70 decoration-2 underline-offset-4 transition-colors hover:text-volt"
        rel="noopener">Galvanite</a
      >.
    </p>
  </div>
</section>
