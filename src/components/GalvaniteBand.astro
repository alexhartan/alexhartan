---
import Logo from './Logo.astro';
---

<section class="relative overflow-hidden bg-volt py-20 text-void md:py-28" aria-label="Galvanite">
  <!-- oversized ghost wordmark -->
  <span
    class="font-display pointer-events-none absolute -top-10 left-0 text-[22vw] leading-none font-bold tracking-tight whitespace-nowrap text-void/5 uppercase"
    aria-hidden="true"
  >
    Galvanite ◥ Galvanite
  </span>

  <div
    class="relative mx-auto flex max-w-[1400px] flex-wrap items-end justify-between gap-10 px-5 md:px-10"
  >
    <div class="max-w-2xl">
      <p class="font-display flex items-center gap-3 text-[13px] font-bold tracking-[0.24em] uppercase" data-reveal>
        <Logo class="h-6" mono />
        My studio
      </p>
      <h2
        class="font-display mt-5 text-5xl leading-[0.95] font-bold tracking-tight uppercase md:text-7xl"
        data-reveal
        style="--d:.08s"
      >
        Galvanite<span aria-hidden="true">&nbsp;◥</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed font-medium text-void/75 md:text-xl" data-reveal style="--d:.16s">
        The lean branding &amp; Webflow studio behind my client work — partnering with a handful of
        B2B startups a year, from Seed to Series B, who are ready to look as sharp as the product
        they've built.
      </p>
    </div>

    <a
      href="https://www.galvanite.io"
      rel="noopener"
      data-magnetic
      class="group font-display inline-flex items-center gap-3 rounded-full bg-void px-8 py-4 text-sm font-bold tracking-[0.14em] text-volt uppercase transition-transform duration-300 hover:scale-[1.04]"
      data-reveal
      style="--d:.2s"
    >
      Visit galvanite.io
      <span class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">
        ↗
      </span>
    </a>
  </div>
</section>
