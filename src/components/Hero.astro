---
const first = [...'ALEX'];
const last = [...'HARTAN'];
---

<section id="top" data-seq-section="hero" class="relative h-svh overflow-hidden">
  <!-- scrubbed frame sequence -->
  <canvas id="seq-hero" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="absolute inset-0 bg-gradient-to-t from-void via-transparent to-void/60" aria-hidden="true"></div>

  <!-- name -->
  <div class="relative z-10 flex h-full flex-col justify-end pb-24 md:justify-center md:pb-0">
    <div class="mx-auto w-full max-w-[1500px] px-5 md:px-10">
      <p
        id="hero-eyebrow"
        class="font-display mb-6 flex items-center gap-3 text-[11px] tracking-[0.28em] text-cream/80 uppercase md:text-[13px]"
      >
        <svg class="h-3 w-3 shrink-0" viewBox="0 0 100 100" aria-hidden="true">
          <polygon points="100,0 100,100 0,100" fill="#FFD400"></polygon>
        </svg>
        Brand strategist <span class="text-mute">&amp;</span> Webflow expert — Founder of Galvanite
      </p>

      <h1
        id="hero-title"
        class="font-display text-[clamp(4rem,17.5vw,17rem)] leading-[0.85] tracking-[-0.01em] uppercase"
      >
        <span class="sr-only">Alex Hartan</span>
        <span class="h-line" aria-hidden="true">
          {first.map((ch, i) => <span class="h-letter" style={`--i:${i}`}>{ch}</span>)}
        </span>
        <span class="h-line" aria-hidden="true">
          {last.map((ch, i) => (
            <span class="h-letter text-outline" style={`--i:${i + first.length}`}>
              {ch}
            </span>
          ))}
        </span>
      </h1>

      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <p
          id="hero-sub"
          class="font-display text-sm tracking-[0.42em] text-volt uppercase md:text-lg"
          style="--i: 11"
        >
          <span class="h-line"><span class="h-letter" style="--i:11">Digital Craftsman</span></span>
        </p>
        <p id="hero-copy" class="max-w-sm text-sm leading-relaxed text-mute md:text-base" data-reveal style="--d:1.2s">
          18+ years turning sharp B2B products into brands that finally look the part.
        </p>
      </div>
    </div>
  </div>

  <!-- mid-scrub accent line -->
  <div
    id="hero-accent"
    class="pointer-events-none absolute inset-0 z-20 grid place-items-center opacity-0"
    aria-hidden="true"
  >
    <p class="font-display px-6 text-center text-[clamp(2rem,7vw,6.5rem)] leading-[1.02] uppercase">
      <span class="block">Strategic design,</span>
      <span class="text-outline-volt block">not decoration.</span>
    </p>
  </div>

  <!-- scroll cue -->
  <div
    id="hero-cue"
    class="font-display absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 items-center gap-3 text-[10px] tracking-[0.3em] text-mute uppercase"
  >
    Scroll to roll the camera
    <span class="inline-block animate-bounce text-volt" aria-hidden="true">▼</span>
  </div>
</section>
