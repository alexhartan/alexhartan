---
import SectionHead from './SectionHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const stats = [
  { value: 18, suffix: '+', label: 'Years in branding & UX' },
  { value: 8, suffix: '', label: 'Weeks from kickoff to launch' },
  { value: 1, suffix: '', label: 'Lean studio, zero agency bloat' },
  { value: null, suffix: '∞', label: 'Meeples moved & jumpers taken' },
];
---

<section id="about" class="relative scroll-mt-24 py-24 md:py-36">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <SectionHead index="02" label="About" />

    <p
      class="font-display max-w-5xl text-4xl leading-[1.05] font-bold tracking-tight text-balance uppercase sm:text-5xl md:text-7xl"
      data-words
    >
      Your product is sharp — I make sure your brand is too.
    </p>

    <div class="mt-16 grid gap-12 md:mt-24 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div class="relative" data-reveal>
        <figure
          data-tilt
          class="group relative overflow-hidden rounded-2xl border border-line bg-panel will-change-transform"
        >
          <img
            src={`${base}/images/portrait-about.jpg`}
            alt="Alex Hartan, arms crossed, smiling"
            width="1000"
            height="935"
            loading="lazy"
            class="block w-full object-cover grayscale-[45%] transition-[filter,transform] duration-700 group-hover:scale-[1.03] group-hover:grayscale-0"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-bg/60 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
        </figure>
        <svg
          class="absolute -right-4 -bottom-4 h-10 w-10 md:-right-6 md:-bottom-6 md:h-14 md:w-14"
          viewBox="0 0 100 100"
          aria-hidden="true"
        >
          <polygon points="100,0 100,100 0,100" fill="#FFD316"></polygon>
        </svg>
      </div>

      <div class="flex flex-col justify-between gap-10">
        <div class="space-y-6 text-lg leading-relaxed text-mute md:text-xl">
          <p data-reveal>
            I'm Alex — a digital craftsman from Craiova, Romania. For the last
            <span class="text-ink">18+ years</span> I've helped tech startups find focus and make an
            impact through purposeful branding and engaging UX.
          </p>
          <p data-reveal style="--d:.1s">
            These days I run <a
              href="https://www.galvanite.io"
              class="text-ink underline decoration-volt/70 decoration-2 underline-offset-4 transition-colors hover:text-volt"
              rel="noopener">Galvanite</a
            >, a lean studio helping Seed-to-Series-B founders close the gap between the product
            they've built and the way the market sees them.
          </p>
          <p data-reveal style="--d:.2s">
            No account managers, no hand-offs, no agency bloat. I take on a handful of startups each
            year and give every one of them full attention — from the first strategy workshop to the
            final Webflow deploy.
          </p>
        </div>

        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line" data-reveal>
          {
            stats.map((s) => (
              <div class="bg-navy p-6 transition-colors duration-300 hover:bg-navy-2 md:p-8">
                <dd
                  class="font-display text-5xl font-bold text-volt md:text-6xl"
                  {...(s.value !== null ? { 'data-count': s.value, 'data-suffix': s.suffix } : {})}
                >
                  {s.value !== null ? `${s.value}${s.suffix}` : s.suffix}
                </dd>
                <dt class="mt-2 text-sm text-mute">{s.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
