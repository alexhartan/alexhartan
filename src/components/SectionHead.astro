---
interface Props {
  index: string;
  label: string;
  class?: string;
}
const { index, label, class: className = '' } = Astro.props;
---

<div class={`mb-12 flex items-center gap-4 md:mb-16 ${className}`} data-reveal>
  <span class="font-display text-sm font-semibold text-volt">{index}</span>
  <span class="h-px w-10 bg-volt/60" aria-hidden="true"></span>
  <h2 class="font-display text-sm font-semibold tracking-[0.26em] uppercase">{label}</h2>
</div>
