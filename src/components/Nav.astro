---
import Logo from './Logo.astro';
---

<header class="fixed inset-x-0 top-0 z-[80]">
  <nav
    class="mx-auto flex max-w-[1500px] items-center justify-between px-5 py-5 md:px-10"
    aria-label="Main"
  >
    <a href="#top" class="flex items-center gap-3" aria-label="Alex Hartan — back to top">
      <Logo class="h-7 md:h-8" />
    </a>

    <div class="font-display hidden items-center gap-8 text-[11px] tracking-[0.24em] uppercase md:flex">
      <a href="#pillars" class="text-cream/70 transition-colors hover:text-volt">What I do</a>
      <a href="#work" class="text-cream/70 transition-colors hover:text-volt">Work</a>
      <a href="#process" class="text-cream/70 transition-colors hover:text-volt">How I work</a>
    </div>

    <a
      href="mailto:alex@galvanite.io"
      class="font-display inline-flex items-center gap-2 border border-line bg-void/40 px-5 py-2.5 text-[11px] tracking-[0.2em] uppercase backdrop-blur-sm transition-colors hover:border-volt hover:text-volt"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="pulse-dot absolute inset-0" aria-hidden="true"></span>
        <span class="relative h-1.5 w-1.5 rounded-full bg-volt"></span>
      </span>
      Start a project
    </a>
  </nav>
</header>
