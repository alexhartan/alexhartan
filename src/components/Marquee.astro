---
interface Props {
  items?: string[];
  reverse?: boolean;
  class?: string;
}
const {
  items = ['Brand Strategy', 'Visual Identity', 'Web Design', 'Webflow Development', 'UX Consulting'],
  reverse = false,
  class: className = '',
} = Astro.props;
---

<div class={`marquee overflow-hidden border-y border-line py-5 md:py-7 ${className}`} aria-hidden="true">
  <div class:list={['marquee-track items-center gap-0', { reverse }]}>
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {items.map((item, i) => (
            <span class="font-display flex items-center text-4xl font-bold tracking-tight whitespace-nowrap uppercase md:text-6xl">
              <span class={i % 2 ? 'text-outline' : 'text-ink'}>{item}</span>
              <svg class="mx-6 h-5 w-5 shrink-0 md:mx-10 md:h-7 md:w-7" viewBox="0 0 100 100">
                <polygon points="100,0 100,100 0,100" fill="#FFD316" />
              </svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
