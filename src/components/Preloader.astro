---
import Logo from './Logo.astro';
---

<div id="preloader" class="fixed inset-0 z-[100] grid place-items-center bg-void">
  <div class="flex flex-col items-center gap-8">
    <Logo class="h-14 md:h-20" />
    <div class="h-px w-56 overflow-hidden bg-line md:w-72">
      <div id="preloader-bar" class="h-full w-full origin-left scale-x-0 bg-volt transition-transform duration-300 ease-out"></div>
    </div>
    <p class="font-display flex items-baseline gap-2 text-xs tracking-[0.3em] text-mute uppercase">
      Rolling film <span id="preloader-pct" class="inline-block w-10 text-right text-volt">0%</span>
    </p>
  </div>
</div>
