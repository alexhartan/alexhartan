---
import Logo from './Logo.astro';
import Marquee from './Marquee.astro';

const year = new Date().getFullYear();
---

<footer class="relative">
  <Marquee
    items={['Find focus', 'Scale your brand', 'Make an impact', 'Stay sharp']}
    reverse
    class="bg-navy/40"
  />

  <div class="mx-auto max-w-[1400px] px-5 py-14 md:px-10">
    <div class="flex flex-wrap items-start justify-between gap-10">
      <div class="max-w-xs">
        <a href="#top" class="inline-flex items-center gap-3" aria-label="Alex Hartan — back to top">
          <Logo class="h-9 text-ink" />
          <span class="font-display text-sm font-semibold tracking-[0.18em] uppercase">Alex Hartan</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-mute">
          Digital craftsman — brand strategy, identity and Webflow for B2B startups.
        </p>
      </div>

      <dl class="font-display grid grid-cols-2 gap-x-16 gap-y-6 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-[11px] tracking-[0.22em] text-mute uppercase">Local time</dt>
          <dd class="mt-2 font-semibold tracking-wide">
            <span id="clock">--:--</span>
          </dd>
        </div>
        <div>
          <dt class="text-[11px] tracking-[0.22em] text-mute uppercase">Based in</dt>
          <dd class="mt-2 font-semibold tracking-wide">Craiova, RO</dd>
        </div>
        <div>
          <dt class="text-[11px] tracking-[0.22em] text-mute uppercase">Working</dt>
          <dd class="mt-2 font-semibold tracking-wide">Worldwide</dd>
        </div>
      </dl>

      <a
        href="#top"
        data-magnetic
        class="group grid h-14 w-14 place-items-center rounded-full border border-line transition-colors duration-300 hover:border-volt hover:bg-volt"
        aria-label="Back to top"
      >
        <svg
          class="h-4 w-4 -rotate-90 transition-transform duration-300 group-hover:-translate-y-0.5"
          viewBox="0 0 100 100"
          aria-hidden="true"
        >
          <polygon points="100,0 100,100 0,100" class="fill-volt transition-colors group-hover:fill-void"
          ></polygon>
        </svg>
      </a>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-xs text-mute"
    >
      <p>© {year} Alex Hartan. All rights sharpened.</p>
      <p>Built with Astro, plenty of contrast &amp; zero agency bloat ◥</p>
    </div>
  </div>
</footer>
