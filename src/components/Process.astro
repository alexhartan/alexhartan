---
const steps = [
  {
    n: '01',
    title: 'Listen',
    desc: 'Deep-dive into your product, your users and your ambitions. I do the homework before touching a single pixel.',
  },
  {
    n: '02',
    title: 'Sharpen',
    desc: 'A strategy sprint that cuts the noise: what you stand for, who it’s for, and why anyone should care.',
  },
  {
    n: '03',
    title: 'Design',
    desc: 'Identity and interface, crafted in Figma. Bold where it matters, invisible where it should be.',
  },
  {
    n: '04',
    title: 'Build',
    desc: 'A clean, lightning-fast Webflow build you can run without me. QA’d, launched, handed over.',
  },
];
---

<section id="process" class="relative border-t border-line bg-ink py-24 md:py-36">
  <div class="mx-auto max-w-[1500px] px-5 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-display text-5xl uppercase md:text-8xl" data-reveal>
        How I <span class="text-outline-volt">work</span>
      </h2>
      <p class="font-display mb-2 text-xs tracking-[0.24em] text-mute uppercase md:text-sm" data-reveal style="--d:.15s">
        Kickoff → launch in ~8 weeks
      </p>
    </div>

    <ol class="mt-14 grid gap-px border border-line bg-line sm:grid-cols-2 xl:grid-cols-4 md:mt-20">
      {
        steps.map((s, i) => (
          <li class="group relative bg-ink p-8 md:p-10" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="absolute inset-x-0 top-0 h-0.75 origin-left scale-x-0 bg-volt transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true" />
            <span class="font-display text-6xl text-outline md:text-7xl" aria-hidden="true">{s.n}</span>
            <h3 class="font-display mt-8 text-2xl uppercase md:mt-12 md:text-3xl">
              <span class="mr-2 align-middle text-sm text-volt">{s.n}</span>
              {s.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-mute">{s.desc}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-2xl text-mute" data-reveal>
      Strategy, identity and website ship together as one tight
      <span class="text-cream">8-week engagement</span> at
      <a href="https://www.galvanite.io" rel="noopener" class="text-volt underline-offset-4 hover:underline">Galvanite</a>.
    </p>
  </div>
</section>
